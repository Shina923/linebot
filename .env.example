# LINE Developers Console → Messaging API channel
LINE_CHANNEL_SECRET=your-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-long-lived-channel-access-token

# Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Firebase Console → 專案設定 → 服務帳戶 → 產生新的私密金鑰
# 把整個 JSON 壓成一行貼上（可直接沿用 dify-firestore 的同一個值）
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}

# 模型、temperature、群組回覆方式等設定在 content/settings.json
